<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Contact Form View (to show event registrations) - Simplified version -->
        <record id="view_partner_form_event_registrations" model="ir.ui.view">
            <field name="name">res.partner.form.event.registrations</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Event Registrations" name="event_registrations">
                        <field name="event_registration_ids" readonly="1" nolabel="1" />
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
